{
  "name": "oz-checkin",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace web",
    "dev:netlify": "netlify dev --filter web",
    "build": "npm run build --workspace web && npm run build --workspace server",
    "db:generate": "npm run db:generate --workspace server",
    "db:migrate": "npm run db:migrate --workspace server",
    "typecheck": "npm run typecheck --workspace server && npm run typecheck --workspace web && tsc --noEmit -p netlify/tsconfig.json",
    "test": "npm run test --workspace server"
  },
  "devDependencies": {
    "netlify-cli": "^27.1.2"
  }
}
