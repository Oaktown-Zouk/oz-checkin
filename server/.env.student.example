# Local dev env for the separate student self-service app (server/src/studentApp.ts,
# via server/src/devStudent.ts) — a distinct file from server/.env so the two apps'
# local dev processes can run side by side with different ports/origins, and so this
# app's AIRTABLE_PAT can genuinely be a different, read-only-scoped token (see
# SPEC.md's "Student self-service login" section) rather than reusing the staff app's
# read/write one even in dev.

PORT=3001

# The browser-facing origin for web-student/'s dev server — see server/.env.example's
# APP_ORIGIN comment for why this can't be derived from the request itself.
APP_ORIGIN=http://localhost:9999

# Same Google OAuth client as the staff app works fine (it's just used for the
# app-to-Google token exchange) — but this app's own redirect URI
# (<APP_ORIGIN>/api/auth/google/callback) needs its own "Authorized redirect URI"
# entry in the same OAuth client, since it's a different origin.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ideally a SEPARATE Airtable PAT scoped to data.records:read only (no write, no
# schema) — see SPEC.md. The staff app's PAT works too if you'd rather not mint a
# second real token just for local dev; either way, same base id.
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

SESSION_SECRET=

# See server/.env.example's DEV_LOGIN_ENABLED comment — same gating, restricted here
# to one fixed fake identity (claude-student@test.com) rather than a role allowlist,
# since this whole app IS the student surface.
DEV_LOGIN_ENABLED=

MOCK_AIRTABLE=
