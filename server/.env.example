# --- Core (required) ---
PORT=3000
DATABASE_PATH=./data/oz-checkin.sqlite

# Any long random string — used to derive the session cookie encryption key.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Shared front-desk password (single login for now, see SPEC.md).
CHECKIN_PASSWORD=

SYNC_INTERVAL_MINUTES=10

# --- Google Forms (optional — sync is skipped if unset) ---
# OAuth "Desktop app" client from console.cloud.google.com, Forms API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One-time: obtain via the OAuth consent flow, see README "Google Forms setup".
GOOGLE_REFRESH_TOKEN=
# The waiver form's ID (from its edit URL: forms.google.com/forms/d/<FORM_ID>/edit)
GOOGLE_FORM_ID=
# Only needed if auto-detection (matching question titles containing "email"/"name")
# picks the wrong question.
GOOGLE_FORMS_EMAIL_QUESTION_ID=
GOOGLE_FORMS_NAME_QUESTION_ID=

# --- Givebutter (optional — sync is skipped if unset) ---
# Account Settings -> API in Givebutter.
GIVEBUTTER_API_KEY=
