# --- Core (required) ---
PORT=3000

# Only read by server/src/db/* and the one-time migration scripts (see README) — the
# app itself talks to Airtable, not a local database.
DATABASE_PATH=./data/oz-checkin.sqlite

# Any long random string — used to derive the session cookie signing key.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# The origin the BROWSER actually sees for this dev mode — NOT necessarily the port
# this process listens on. For `npm run dev` (two-terminal, API on :3000 behind Vite's
# proxy on :5173), this must be http://localhost:5173, since that's what the browser
# talks to. For `netlify dev`, use http://localhost:8888. In production, the real domain.
APP_ORIGIN=http://localhost:5173

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials →
# "OAuth client ID", type "Web application"). Register an "Authorized redirect URI" of
# <APP_ORIGIN>/api/auth/google/callback for every APP_ORIGIN value this app runs under
# (http://localhost:5173, http://localhost:8888, and the production domain).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Airtable Personal Access Token (scopes: schema.bases:read, data.records:read,
# data.records:write) and the base id (from its URL, starts with "app").
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# --- Local dev only — never set in production ---

# Enables GET /api/auth/dev-login?email=<address> (see routes/auth.ts), which
# mints a real session for an existing User Roles email without going through Google's
# consent screen — useful for an agent/script to log in without a human present. Only
# takes effect when NODE_ENV isn't "production" too, so this can't go live from a
# single misconfigured var. Leave unset/blank normally.
DEV_LOGIN_ENABLED=
