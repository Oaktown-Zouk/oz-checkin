# Root-level env file — read by `netlify dev` (Netlify Dev has no concept of
# server/.env; it only reads a .env at the site's base directory). This duplicates
# server/.env's values — keep them in sync. server/.env is still what `npm run dev`
# (the plain tsx workflow, not going through Netlify Dev) reads.
SESSION_SECRET=
CHECKIN_PASSWORD=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=
