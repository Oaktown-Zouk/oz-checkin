# Root-level env file — read by `netlify dev` (Netlify Dev has no concept of
# server/.env; it only reads a .env at the site's base directory). This duplicates
# server/.env's values — keep them in sync. server/.env is still what `npm run dev`
# (the plain tsx workflow, not going through Netlify Dev) reads.
SESSION_SECRET=
# netlify dev serves everything on one origin — see server/.env.example for what this
# value means and why it differs per dev mode.
APP_ORIGIN=http://localhost:8888
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AIRTABLE_PAT=
AIRTABLE_BASE_ID=

# Local dev only — see server/.env.example. Never set in production.
DEV_LOGIN_ENABLED=
